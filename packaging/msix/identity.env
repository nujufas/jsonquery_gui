# Package identity for build-msix.ps1 (KEY=value, no quotes; # starts a comment).
#
# STORE_*: paste from Partner Center > your app > Product management > Product identity,
#          exactly as shown (case-sensitive). Empty until the app name is reserved; the
#          Store build is skipped while they are empty. They are not secret: every published
#          package carries them in its manifest.
STORE_IDENTITY_NAME=Nujufas.jsonquerygui
STORE_PUBLISHER=CN=084F6F02-A6FD-49D4-9A3A-174F65AAE080
STORE_PUBLISHER_DISPLAY_NAME=Nujufas
# Store ID 9P6VCJBVXLCP; Package Family Name Nujufas.jsonquerygui_j01s9e7gq6y9p (both derived, for reference).

# DEV_*:   identity of the sideload test build, signed with a throwaway self-signed certificate
#          (the certificate's subject must equal DEV_PUBLISHER). Never uploaded to the Store.
DEV_IDENTITY_NAME=nujufas.JsonQueryGui
DEV_PUBLISHER=CN=nujufas
DEV_PUBLISHER_DISPLAY_NAME=nujufas

# The name shown in the Start menu and app list (the Store listing name is set in Partner Center).
DISPLAY_NAME=jsonquery gui
