# syntax=docker/dockerfile:1
#
# A headless Android emulator plus the test tooling (adb, Robot Framework,
# Tesseract OCR), for android/test. Needs KVM at run time (--device /dev/kvm).
#
# The system image is Android 16 with 16 KB memory pages
# ("google_apis_ps16k"): the page size Google Play now requires apps to
# support, so a test run on it also proves the native library loads there.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG CMDLINE_TOOLS_BUILD=16111833
ARG SYSTEM_IMAGE="system-images;android-36;google_apis_ps16k;x86_64"

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_AVD_HOME=/opt/avd \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    PATH=/opt/venv/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl unzip procps iproute2 \
        openjdk-17-jre-headless \
        libgl1 libnss3 libxcomposite1 libxcursor1 libxdamage1 libxi6 libxtst6 libxrandr2 \
        libx11-6 libx11-xcb1 libxkbfile1 libxkbcommon0 libxkbcommon-x11-0 libdbus-1-3 \
        libasound2t64 libpulse0 libxcb-xinerama0 libxcb-cursor0 libxfixes3 libxext6 \
        python3 python3-venv tesseract-ocr tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools \
 && curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS_BUILD}_latest.zip" -o /tmp/cmdline-tools.zip \
 && unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools \
 && mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
 && rm /tmp/cmdline-tools.zip \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager --install "platform-tools" "emulator" "${SYSTEM_IMAGE}" \
 && rm -rf ${ANDROID_HOME}/.temp

# A Pixel 3-sized phone: 1080x2160 (exactly 2:1, the tallest a Play Store
# screenshot may be) at 440 dpi, software GPU.
RUN mkdir -p ${ANDROID_AVD_HOME} \
 && echo no | avdmanager create avd --force --name phone --package "${SYSTEM_IMAGE}" --device pixel_3 \
 && printf '%s\n' \
        'hw.gpu.enabled=yes' 'hw.gpu.mode=swiftshader_indirect' \
        'hw.ramSize=3072' 'hw.keyboard=yes' 'showDeviceFrame=no' \
        'disk.dataPartition.size=4G' >> ${ANDROID_AVD_HOME}/phone.avd/config.ini

RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir 'robotframework>=7.0' 'pytesseract>=0.3' Pillow

# What the emulator's own window (its Qt toolkit) needs, for a person to use it
# by hand: android/scripts/run-phone.sh and run-tablet.sh. The test runs are
# headless and never load it. Its own layer, last, so that adding it did not
# rebuild the ~9 GB above.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libsm6 libice6 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
